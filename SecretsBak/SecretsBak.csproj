<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Global tool settings -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>secretsbak</ToolCommandName>
        <PackageId>SecretsBak</PackageId>
        <Version>0.1.7</Version>
        <Authors>Tayo</Authors>
        <Description>Backup and restore .NET User Secrets to S3</Description>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/TayoAderiye/SecretsBak</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/TayoAderiye/SecretsBak</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.2" />
      <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.2" />
    </ItemGroup>
    <ItemGroup>
        <!-- Pack repo-root README into the package root -->
        <None Include="..\README.md" Pack="true" PackagePath="README.md" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Helpers\Helpers.csproj" />
    </ItemGroup>

</Project>
